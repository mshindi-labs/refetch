{
  "name": "@mshindi-labs/refetch",
  "version": "3.0.0",
  "description": "A modern, production-grade HTTP client built on native fetch — functional TypeScript, interceptors, retry, streaming, and tree-shakeable exports",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./retry": {
      "types": "./dist/retry.d.ts",
      "import": "./dist/retry.js",
      "require": "./dist/retry.cjs"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js",
      "require": "./dist/middleware.cjs"
    },
    "./pipe": {
      "types": "./dist/pipe.d.ts",
      "import": "./dist/pipe.js",
      "require": "./dist/pipe.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "size": "size-limit",
    "check:package": "attw --pack . --ignore-rules false-esm no-resolution && publint",
    "smoke": "node scripts/smoke.mjs",
    "ci": "npm run lint && npm run typecheck && npm run build && npm run test:coverage && npm run check:package && npm run size && npm run smoke",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "fetch",
    "http",
    "client",
    "api",
    "rest",
    "typescript",
    "apisauce",
    "request",
    "ajax",
    "xhr"
  ],
  "author": "mshindi-labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mshindi-labs/refetch"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.15",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "publint": "^0.3.25",
    "size-limit": "^14.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
