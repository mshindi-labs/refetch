{
  "name": "@mshindi-labs/refetch",
  "version": "3.2.0",
  "description": "A modern, production-grade HTTP client built on native fetch — functional TypeScript, interceptors, retry, streaming, and tree-shakeable exports",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./retry": {
      "import": {
        "types": "./dist/retry.d.ts",
        "default": "./dist/retry.js"
      },
      "require": {
        "types": "./dist/retry.d.cts",
        "default": "./dist/retry.cjs"
      }
    },
    "./middleware": {
      "import": {
        "types": "./dist/middleware.d.ts",
        "default": "./dist/middleware.js"
      },
      "require": {
        "types": "./dist/middleware.d.cts",
        "default": "./dist/middleware.cjs"
      }
    },
    "./pipe": {
      "import": {
        "types": "./dist/pipe.d.ts",
        "default": "./dist/pipe.js"
      },
      "require": {
        "types": "./dist/pipe.d.cts",
        "default": "./dist/pipe.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "retry": [
        "./dist/retry.d.ts"
      ],
      "middleware": [
        "./dist/middleware.d.ts"
      ],
      "pipe": [
        "./dist/pipe.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "size": "size-limit",
    "check:package": "attw --pack . && publint --strict",
    "smoke": "node scripts/smoke.mjs",
    "ci": "npm run lint && npm run typecheck && npm run build && npm run test:coverage && npm run check:package && npm run size && npm run smoke",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "fetch",
    "http",
    "client",
    "api",
    "rest",
    "typescript",
    "apisauce",
    "request",
    "ajax",
    "xhr"
  ],
  "author": "mshindi-labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mshindi-labs/refetch.git"
  },
  "homepage": "https://github.com/mshindi-labs/refetch#readme",
  "bugs": {
    "url": "https://github.com/mshindi-labs/refetch/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.15",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "publint": "^0.3.25",
    "size-limit": "^14.2.0",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
